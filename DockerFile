# -------------------- Base Image --------------------
# Use the official Python 3.10 slim image (lighter than full image)
FROM python:3.10-slim


# -------------------- Environment Variables --------------------
# Prevent Python from writing .pyc files (keeps container clean)
ENV PYTHONDONTWRITEBYTECODE=1
# Force stdout/stderr to be shown instantly (no buffering)
ENV PYTHONUNBUFFERED=1


# -------------------- Working Directory --------------------
# Set the working directory inside the container as /app
# All subsequent commands (COPY, RUN, CMD) will be relative to /app
WORKDIR /app


# -------------------- System Dependencies --------------------
# Update package list, install build tools & poppler-utils (needed for PDFs),
# then clean up to reduce image size
RUN apt-get update && apt-get install -y build-essential \
    poppler-utils && rm -rf /var/lib/apt/lists/*


# -------------------- Install Python Dependencies --------------------
# Copy only requirements.txt first (for caching efficiency)
COPY requirements.txt .

# Copy .env file into container (so app can read environment variables)
COPY .env .

# Install Python dependencies from requirements.txt
RUN pip install --no-cache-dir -r requirements.txt


# -------------------- Copy Project Code --------------------
# Copy all project files (your app) into the /app directory in container
COPY . .


# -------------------- Expose Port --------------------
# Expose port 8080 so the app inside the container can be accessed outside
EXPOSE 8080


# -------------------- Run Application --------------------
# Start FastAPI app using uvicorn
# "api.main:app" → means inside api/main.py there is a variable "app = FastAPI()"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
